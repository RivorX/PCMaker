# Sekret do podpisywania i weryfikacji sesji JWT (wygeneruj dowolny losowy ciąg znaków)
SESSION_SECRET="replace-with-a-random-secret"

# Dane lokalnego administratora
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-local-admin-password"
ADMIN_EMAIL="admin@pcmaker.local"

# Konfiguracja Firebase (wymagana do połączenia z bazą Data Connect)
NEXT_PUBLIC_FIREBASE_PROJECT_ID="pcmaker-b0b0a"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="pcmaker-b0b0a.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_API_KEY="tutaj-wklej-api-key-z-firebase-console"

# Tylko serwer: poświadczenia Firebase Admin SDK dla prywatnych operacji
# Data Connect, np. weryfikacji hasła podczas logowania. Nie używaj prefiksu
# NEXT_PUBLIC_ i nie umieszczaj pliku JSON z kluczem w repozytorium.
# Lokalnie: każdy współpracownik umieszcza własny plik JSON w tym ignorowanym
# katalogu. Docker montuje go jako sekret pod ścieżką /run/secrets/.
GOOGLE_APPLICATION_CREDENTIALS="./secrets/firebase-admin.json"
# FIREBASE_PROJECT_ID="pcmaker-b0b0a"
