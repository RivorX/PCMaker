# Wartość serwerowa. Uzupełnij danymi z wybranego hostingu PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Sekret do podpisywania i weryfikacji sesji JWT
SESSION_SECRET="replace-with-a-random-secret"

# Dane administratora 
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-local-admin-password"

# Opcjonalny, lokalny snapshot JSON wygenerowany importerem UserBenchmark.
# Gdy ustawiony, błędny lub niedostępny plik powoduje 503 katalogu; nie ma
# cichego powrotu do danych przykładowych. Ścieżka jest czytana wyłącznie po
# stronie serwera i nie jest zwracana klientowi.
# CATALOG_DATA_FILE="./data/userbenchmark.components.json"

# Źródło katalogu: sample (domyślne) / file / firebase.
# Firebase wykonuje wyłącznie serwerowy, read-only odczyt ListComponents.
# CATALOG_SOURCE="sample"
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# Opcjonalne segmenty Firebase Data Connect (mają bezpieczne wartości domyślne).
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="pcmaker-b0b0a"
# FIREBASE_DATACONNECT_LOCATION="europe-central2"
# FIREBASE_DATACONNECT_SERVICE="pcmaker-service"
# FIREBASE_DATACONNECT_CONNECTOR="default"

# SerpAPI Google Shopping (tylko backend; nigdy nie wystawiaj klucza w kliencie).
# SERPAPI_API_KEY=""
# Opcjonalna stała robocza do przeliczenia wykrytej ceny EUR na orientacyjne PLN;
# nie jest kursem live. Ceny USD i bez rozpoznanej waluty pozostają niedostępne.
EUR_PLN_RATE="4.30"
